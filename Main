  apiKey: "AIzaSyA8BWWw_Izu01SwFs_UoaPlbjeVtdqbVH8",
  authDomain: "ferme-6cf80.firebaseapp.com",
  projectId: "ferme-6cf80",
  storageBucket: "ferme-6cf80.firebasestorage.app",
  messagingSenderId: "573100322265",
  appId: "1:573100322265:web:cd3bb001fa451ab4b0fdc8",
  measurementId: "G-HZHTFSKFSJ"
};

// Initialisation de Firebase
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const animalsCollectionRef = collection(db, "animals");

// STUB: Helper functions
const formatDate = (date) => {
  if (!date) return 'Date inconnue';
  const dateObj = date.toDate ? date.toDate() : new Date(date);
  return dateObj.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
};

const AnimalIcon = ({ species, className }) => {
  const defaultClass = "w-6 h-6 inline-block mr-2";
  const combinedClass = `${defaultClass} ${className}`;
  switch (species?.toLowerCase()) {
    case 'chèvre': return <Bug className={combinedClass} />;
    case 'lapin': return <Rabbit className={combinedClass} />;
    case 'poule': return <Bird className={combinedClass} />;
    case 'dindon': return <Bird className={combinedClass} />;
    default: return <Heart className={combinedClass} />;
  }
};

// STUB: Main Application Component
export default function App() {
  const [animals, setAnimals] = useState([]);
  const [loading, setLoading] = useState(true);
  const [isAuthReady, setIsAuthReady] = useState(false);
  const [selectedAnimal, setSelectedAnimal] = useState(null);
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingAnimal, setEditingAnimal] = useState(null);
  const [searchTerm, setSearchTerm] = useState('');
  const [speciesFilter, setSpeciesFilter] = useState('Tous');
  const [darkMode, setDarkMode] = useState(false);
  const [currentView, setCurrentView] = useState('dashboard'); // 'dashboard' or 'calendar'

  useEffect(() => {
    const unsubscribeAuth = onAuthStateChanged(auth, (user) => {
      if (user) {
        setIsAuthReady(true);
      } else {
        signInAnonymously(auth).catch((error) => console.error("Erreur d'authentification anonyme:", error));
      }
    });
    return () => unsubscribeAuth();
  }, []);

  useEffect(() => {
    if (!isAuthReady) return;

    setLoading(true);
    const unsubscribeFirestore = onSnapshot(animalsCollectionRef, (snapshot) => {
      const animalsData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      setAnimals(animalsData);
      if (selectedAnimal) {
        const updatedSelected = animalsData.find(a => a.id === selectedAnimal.id);
        setSelectedAnimal(updatedSelected || null);
      }
      setLoading(false);
    }, (error) => {
      console.error("Erreur de lecture Firestore: ", error);
      setLoading(false);
    });

    return () => unsubscribeFirestore();
  }, [isAuthReady]);

  useEffect(() => {
    document.body.className = darkMode ? 'bg-gray-900' : 'bg-gray-100';
  }, [darkMode]);

  const handleSaveAnimal = async (animalData) => {
    try {
      const dataToSave = { ...animalData, dob: animalData.dob ? Timestamp.fromDate(new Date(animalData.dob)) : null };
      if (editingAnimal) {
        await updateDoc(doc(db, "animals", editingAnimal.id), dataToSave);
      } else {
        await addDoc(animalsCollectionRef, { ...dataToSave, healthLog: [], events: [] });
      }
      closeModal();
    } catch (error) {
      console.error("Erreur lors de la sauvegarde de l'animal: ", error);
    }
  };

  const handleDeleteAnimal = async (animalId) => {
    try {
      await deleteDoc(doc(db, "animals", animalId));
      setSelectedAnimal(null);
    } catch (error) {
      console.error("Erreur lors de la suppression de l'animal: ", error);
    }
  };

  const handleAddLogEntry = async (animalId, logType, entry) => {
    try {
      const animalDoc = doc(db, "animals", animalId);
      const entryWithTimestamp = { ...entry, id: Date.now(), date: Timestamp.fromDate(new Date(entry.date)) };
      await updateDoc(animalDoc, { [logType]: arrayUnion(entryWithTimestamp) });
    } catch (error) {
      console.error(`Erreur lors de l'ajout à ${logType}:`, error);
    }
  };

  const handleDeleteLogEntry = async (animalId, logType, entry) => {
    try {
      await updateDoc(doc(db, "animals", animalId), { [logType]: arrayRemove(entry) });
    } catch (error) {
      console.error(`Erreur lors de la suppression de ${logType}:`, error);
    }
  };

  const openModal = (animal = null) => {
    setEditingAnimal(animal);
    setIsModalOpen(true);
  };

  const closeModal = () => {
    setIsModalOpen(false);
    setEditingAnimal(null);
  };

  const filteredAnimals = animals
    .filter(animal => animal.name.toLowerCase().includes(searchTerm.toLowerCase()))
    .filter(animal => speciesFilter === 'Tous' || animal.species === speciesFilter);

  const uniqueSpecies = ['Tous', ...new Set(animals.map(a => a.species))];

  if (selectedAnimal) {
    return <AnimalProfile animal={selectedAnimal} onBack={() => setSelectedAnimal(null)} onEdit={() => openModal(selectedAnimal)} onDelete={() => handleDeleteAnimal(selectedAnimal.id)} onAddLogEntry={handleAddLogEntry} onDeleteLogEntry={handleDeleteLogEntry} darkMode={darkMode} />;
  }

  return (
    <div className={`min-h-screen font-sans transition-colors duration-300 ${darkMode ? 'dark' : ''}`}>
      <div className="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
        <header className="flex justify-between items-center mb-8">
          <div>
            <h1 className="text-3xl sm:text-4xl font-bold text-gray-800 dark:text-white">La Ferme de Maman</h1>
            <p className="text-gray-500 dark:text-gray-400 mt-1">Tableau de bord de la ferme pédagogique</p>
          </div>
          <div className="flex items-center space-x-2 sm:space-x-4">
            <button onClick={() => setDarkMode(!darkMode)} className="p-2 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
              {darkMode ? <Sun size={20} /> : <Moon size={20} />}
            </button>
            <button onClick={() => setCurrentView(currentView === 'dashboard' ? 'calendar' : 'dashboard')} className="flex items-center bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 font-bold py-2 px-4 rounded-lg">
              {currentView === 'dashboard' ? <Calendar size={20} className="mr-2" /> : <ClipboardList size={20} className="mr-2" />}
              <span className="hidden sm:inline">{currentView === 'dashboard' ? 'Calendrier' : 'Dashboard'}</span>
            </button>
            <button onClick={() => openModal()} className="flex items-center bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-2 px-4 rounded-lg shadow-md">
              <Plus size={20} className="mr-0 sm:mr-2" />
              <span className="hidden sm:inline">Ajouter</span>
            </button>
          </div>
        </header>

        {currentView === 'calendar' ? (
          <CalendarView animals={animals} darkMode={darkMode} />
        ) : (
          <>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
              <StatCard title="Total des Animaux" value={animals.length} icon={<ClipboardList />} darkMode={darkMode} />
              <StatCard title="En bonne santé" value={animals.filter(a => a.healthStatus === 'Bonne santé').length} icon={<Heart />} color="text-green-500" darkMode={darkMode} />
              <StatCard title="À surveiller" value={animals.filter(a => a.healthStatus === 'À surveiller').length} icon={<Shield />} color="text-yellow-500" darkMode={darkMode} />
              <StatCard title="Espèces" value={uniqueSpecies.length - 1} icon={<Rabbit />} darkMode={darkMode} />
            </div>
            <div className="mb-6 flex flex-col sm:flex-row gap-4">
              <input type="text" placeholder="Rechercher par nom..." value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} className="flex-grow p-3 rounded-lg border bg-white dark:bg-gray-800 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500" />
              <div className="relative">
                <select value={speciesFilter} onChange={(e) => setSpeciesFilter(e.target.value)} className="appearance-none w-full sm:w-48 p-3 rounded-lg border bg-white dark:bg-gray-800 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                  {uniqueSpecies.map(species => <option key={species} value={species}>{species}</option>)}
                </select>
                <ChevronDown className="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" />
              </div>
            </div>
            {loading ? <div className="text-center py-12 col-span-full text-gray-500 dark:text-gray-400">Chargement...</div> : (
              <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                {filteredAnimals.map(animal => <AnimalCard key={animal.id} animal={animal} onSelect={() => setSelectedAnimal(animal)} darkMode={darkMode} />)}
              </div>
            )}
            {!loading && filteredAnimals.length === 0 && <div className="col-span-full text-center py-12 bg-white dark:bg-gray-800 rounded-lg"><p className="text-gray-500 dark:text-gray-400">Aucun animal trouvé.</p></div>}
          </>
        )}
        {isModalOpen && <AnimalFormModal onClose={closeModal} onSave={handleSaveAnimal} animal={editingAnimal} darkMode={darkMode} />}
      </div>
    </div>
  );
}

// STUB: Calendar View Component
const CalendarView = ({ animals, darkMode }) => {
    const [currentDate, setCurrentDate] = useState(new Date());

    const allEvents = animals.flatMap(animal => 
        (animal.events || []).map(event => ({
            ...event,
            animalName: animal.name,
            animalSpecies: animal.species
        }))
    );

    const startOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
    const endOfMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
    const startDate = new Date(startOfMonth);
    startDate.setDate(startDate.getDate() - startDate.getDay()); // Start on Sunday
    const endDate = new Date(endOfMonth);
    if(endDate.getDay() !== 6) {
        endDate.setDate(endDate.getDate() + (6 - endDate.getDay())); // End on Saturday
    }

    const days = [];
    let day = new Date(startDate);
    while (day <= endDate) {
        days.push(new Date(day));
        day.setDate(day.getDate() + 1);
    }
    
    const changeMonth = (amount) => {
        setCurrentDate(prevDate => {
            const newDate = new Date(prevDate);
            newDate.setMonth(newDate.getMonth() + amount);
            return newDate;
        });
    };

    return (
        <div className={`p-4 sm:p-6 rounded-xl shadow-lg ${darkMode ? 'bg-gray-800' : 'bg-white'}`}>
            <div className="flex justify-between items-center mb-4">
                <button onClick={() => changeMonth(-1)} className="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700"><ArrowLeft size={20} /></button>
                <h2 className="text-xl sm:text-2xl font-bold text-gray-800 dark:text-white capitalize">
                    {currentDate.toLocaleString('fr-FR', { month: 'long', year: 'numeric' })}
                </h2>
                <button onClick={() => changeMonth(1)} className="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700"><ArrowRight size={20} /></button>
            </div>
            <div className="grid grid-cols-7 gap-1 text-center font-semibold text-gray-600 dark:text-gray-300 mb-2">
                {['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'].map(day => <div key={day}>{day}</div>)}
            </div>
            <div className="grid grid-cols-7 gap-1">
                {days.map((d, i) => {
                    const isCurrentMonth = d.getMonth() === currentDate.getMonth();
                    const isToday = new Date().toDateString() === d.toDateString();
                    const eventsOnDay = allEvents.filter(e => e.date.toDate().toDateString() === d.toDateString());
                    return (
                        <div key={i} className={`h-24 sm:h-32 rounded-lg p-2 border ${isCurrentMonth ? (darkMode ? 'bg-gray-700 border-gray-600' : 'bg-white border-gray-200') : (darkMode ? 'bg-gray-800 border-gray-700' : 'bg-gray-50 border-gray-100')} overflow-y-auto`}>
                            <div className={`font-bold ${isToday ? 'bg-emerald-500 text-white rounded-full w-7 h-7 flex items-center justify-center' : ''} ${isCurrentMonth ? '' : 'text-gray-400'}`}>
                                {d.getDate()}
                            </div>
                            <div className="mt-1 space-y-1">
                                {eventsOnDay.map(event => (
                                    <div key={event.id} className="text-xs p-1 rounded-md bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 flex items-center">
                                       <AnimalIcon species={event.animalSpecies} className="w-4 h-4 mr-1 flex-shrink-0" />
                                       <span className="truncate">{event.animalName}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    );
};


// Other components (StatCard, AnimalCard, AnimalProfile, LogSection, AddLogEntryForm, AnimalFormModal) remain the same
// ... (The code for these components is omitted for brevity but should be included from the previous version)
const StatCard = ({ title, value, icon, color = 'text-emerald-500', darkMode }) => ( <div className={`p-6 rounded-xl shadow-sm transition-all duration-300 ${darkMode ? 'bg-gray-800' : 'bg-white'}`}> <div className="flex items-center justify-between"> <div> <p className="text-sm font-medium text-gray-500 dark:text-gray-400">{title}</p> <p className="text-3xl font-bold text-gray-800 dark:text-white">{value}</p> </div> <div className={`p-3 rounded-full ${darkMode ? 'bg-gray-700' : 'bg-emerald-100'}`}> {React.cloneElement(icon, { className: `w-6 h-6 ${color}` })} </div> </div> </div> );
const AnimalCard = ({ animal, onSelect, darkMode }) => ( <div onClick={onSelect} className={`overflow-hidden rounded-xl shadow-lg cursor-pointer group transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl ${darkMode ? 'bg-gray-800' : 'bg-white'}`}> <img src={animal.photo || 'https://placehold.co/400x400/CCCCCC/FFFFFF?text=Photo?'} alt={animal.name} className="w-full h-48 object-cover" onError={(e) => { e.target.onerror = null; e.target.src = 'https://placehold.co/400x400/CCCCCC/FFFFFF?text=Image+N/A'; }} /> <div className="p-4"> <div className="flex items-center justify-between"> <h3 className="text-xl font-bold text-gray-800 dark:text-white">{animal.name}</h3> <AnimalIcon species={animal.species} className="text-gray-400" /> </div> <p className="text-gray-500 dark:text-gray-400">{animal.species} - {animal.breed}</p> <div className={`mt-3 inline-flex items-center text-sm font-semibold px-2.5 py-0.5 rounded-full ${ animal.healthStatus === 'Bonne santé' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300' }`}> {animal.healthStatus} </div> </div> </div> );
const AnimalProfile = ({ animal, onBack, onEdit, onDelete, darkMode, onAddLogEntry, onDeleteLogEntry }) => { const [showHealthForm, setShowHealthForm] = useState(false); const [showEventForm, setShowEventForm] = useState(false); return ( <div className={`min-h-screen font-sans transition-colors duration-300 ${darkMode ? 'dark' : ''}`}> <div className="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8"> <div className="flex justify-between items-start mb-6"> <button onClick={onBack} className="text-emerald-600 dark:text-emerald-400 hover:underline flex items-center"> &larr; Retour à la liste </button> <div className="flex space-x-2"> <button onClick={onEdit} className="p-2 rounded-full bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600"> <Edit size={20} className="text-gray-600 dark:text-gray-300" /> </button> <button onClick={onDelete} className="p-2 rounded-full bg-red-100 hover:bg-red-200 dark:bg-red-900 dark:hover:bg-red-800"> <Trash2 size={20} className="text-red-600 dark:text-red-300" /> </button> </div> </div> <div className={`rounded-xl shadow-xl overflow-hidden ${darkMode ? 'bg-gray-800' : 'bg-white'}`}> <div className="md:flex"> <div className="md:flex-shrink-0"> <img className="h-64 w-full object-cover md:w-64" src={animal.photo || 'https://placehold.co/400x400/CCCCCC/FFFFFF?text=Photo?'} alt={animal.name} onError={(e) => { e.target.onerror = null; e.target.src = 'https://placehold.co/400x400/CCCCCC/FFFFFF?text=Image+N/A'; }} /> </div> <div className="p-8 flex-grow"> <div className="flex items-center justify-between"> <h1 className="text-3xl font-bold text-gray-900 dark:text-white">{animal.name}</h1> <div className={`text-sm font-semibold px-3 py-1 rounded-full ${ animal.healthStatus === 'Bonne santé' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300' }`}> {animal.healthStatus} </div> </div> <p className="mt-1 text-gray-500 dark:text-gray-400">{animal.species} - {animal.breed}</p> <p className="mt-1 text-gray-500 dark:text-gray-400">Né(e) le: {formatDate(animal.dob)}</p> <p className="mt-4 text-gray-600 dark:text-gray-300">{animal.notes}</p> </div> </div> <div className="p-8 border-t border-gray-200 dark:border-gray-700"> <div className="grid grid-cols-1 md:grid-cols-2 gap-8"> <LogSection title="Carnet de Santé" logType="healthLog" animal={animal} onAddLogEntry={onAddLogEntry} onDeleteLogEntry={onDeleteLogEntry} showForm={showHealthForm} setShowForm={setShowHealthForm} darkMode={darkMode} /> <LogSection title="Participations (Ferme Pédagogique)" logType="events" animal={animal} onAddLogEntry={onAddLogEntry} onDeleteLogEntry={onDeleteLogEntry} showForm={showEventForm} setShowForm={setShowEventForm} darkMode={darkMode} /> </div> </div> </div> </div> </div> ); };
const LogSection = ({ title, logType, animal, onAddLogEntry, onDeleteLogEntry, showForm, setShowForm, darkMode }) => { const logData = animal[logType] || []; const sortedLogData = [...logData].sort((a, b) => b.date.toDate() - a.date.toDate()); return ( <div> <div className="flex justify-between items-center mb-4"> <h2 className="text-xl font-semibold text-gray-800 dark:text-white">{title}</h2> <button onClick={() => setShowForm(!showForm)} className="text-emerald-600 dark:text-emerald-400 hover:underline text-sm font-semibold"> {showForm ? 'Annuler' : 'Ajouter'} </button> </div> {showForm && ( <AddLogEntryForm logType={logType} onAdd={(entry) => { onAddLogEntry(animal.id, logType, entry); setShowForm(false); }} darkMode={darkMode} /> )} <ul className="space-y-3 mt-4"> {sortedLogData.length > 0 ? sortedLogData.map((log) => ( <li key={log.id} className="flex items-start justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-lg"> <div> <p className="font-semibold text-gray-700 dark:text-gray-200">{log.event || log.name}</p> <p className="text-sm text-gray-500 dark:text-gray-400">{formatDate(log.date)}</p> {log.notes && <p className="text-sm mt-1 text-gray-600 dark:text-gray-300 italic">"{log.notes}"</p>} </div> <button onClick={() => onDeleteLogEntry(animal.id, logType, log)} className="p-1 text-gray-400 hover:text-red-500"> <Trash2 size={16} /> </button> </li> )) : <p className="text-gray-500 dark:text-gray-400">Aucune entrée.</p>} </ul> </div> ); };
const AddLogEntryForm = ({ logType, onAdd, darkMode }) => { const [date, setDate] = useState(new Date().toISOString().split('T')[0]); const [eventName, setEventName] = useState(''); const [notes, setNotes] = useState(''); const handleSubmit = (e) => { e.preventDefault(); if (!eventName || !date) return; const entry = logType === 'healthLog' ? { date, event: eventName, notes } : { date, name: eventName, notes }; onAdd(entry); }; return ( <form onSubmit={handleSubmit} className={`p-4 border rounded-lg space-y-3 ${darkMode ? 'bg-gray-700 border-gray-600' : 'bg-gray-50 border-gray-200'}`}> <input type="text" placeholder={logType === 'healthLog' ? "Événement (ex: Vaccin)" : "Nom (ex: EHPAD 'Le Chêne Doré')"} value={eventName} onChange={(e) => setEventName(e.target.value)} required className={`w-full p-2 rounded-md border focus:outline-none focus:ring-1 focus:ring-emerald-500 ${darkMode ? 'bg-gray-600 border-gray-500' : 'bg-white border-gray-300'}`} /> <input type="date" value={date} onChange={(e) => setDate(e.target.value)} required className={`w-full p-2 rounded-md border focus:outline-none focus:ring-1 focus:ring-emerald-500 ${darkMode ? 'bg-gray-600 border-gray-500' : 'bg-white border-gray-300'}`} /> <textarea placeholder="Notes (optionnel)" value={notes} onChange={(e) => setNotes(e.target.value)} rows="2" className={`w-full p-2 rounded-md border focus:outline-none focus:ring-1 focus:ring-emerald-500 ${darkMode ? 'bg-gray-600 border-gray-500' : 'bg-white border-gray-300'}`}></textarea> <button type="submit" className="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold py-2 px-4 rounded-md"> Enregistrer </button> </form> ); };
const AnimalFormModal = ({ onClose, onSave, animal, darkMode }) => { const [formData, setFormData] = useState({ name: '', species: '', breed: '', dob: '', photo: '', healthStatus: 'Bonne santé', notes: '' }); useEffect(() => { if (animal) { const dobForInput = animal.dob?.toDate ? animal.dob.toDate().toISOString().split('T')[0] : animal.dob || ''; setFormData({ ...animal, dob: dobForInput }); } else { setFormData({ name: '', species: '', breed: '', dob: '', photo: '', healthStatus: 'Bonne santé', notes: '' }); } }, [animal]); const handleChange = (e) => { const { name, value } = e.target; setFormData(prev => ({ ...prev, [name]: value })); }; const handleSubmit = (e) => { e.preventDefault(); if (!formData.name || !formData.species) { console.error("Le nom et l'espèce sont obligatoires."); return; } onSave(formData); }; return ( <div className="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50 p-4"> <div className={`w-full max-w-lg p-8 rounded-2xl shadow-2xl relative transform transition-all ${darkMode ? 'bg-gray-800 text-white' : 'bg-white'}`}> <button onClick={onClose} className="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"> <X size={24} /> </button> <h2 className="text-2xl font-bold mb-6">{animal ? "Modifier l'animal" : "Ajouter un nouvel animal"}</h2> <form onSubmit={handleSubmit} className="space-y-4"> <input type="text" name="name" placeholder="Nom de l'animal" value={formData.name} onChange={handleChange} required className={`w-full p-3 rounded-lg border focus:outline-none focus:ring-2 focus:ring-emerald-500 ${darkMode ? 'bg-gray-700 border-gray-600' : 'bg-gray-50 border-gray-300'}`} /> <div className="grid grid-cols-1 sm:grid-cols-2 gap-4"> <input type="text" name="species" placeholder="Espèce (ex: Chèvre)" value={formData.species} onChange={handleChange} required className={`w-full p-3 rounded-lg border focus:outline-none focus:ring-2 focus:ring-emerald-500 ${darkMode ? 'bg-gray-700 border-gray-600' : 'bg-gray-50 border-gray-300'}`} /> <input type="text" name="breed" placeholder="Race (ex: Naine)" value={formData.breed} onChange={handleChange} className={`w-full p-3 rounded-lg border focus:outline-none focus:ring-2 focus:ring-emerald-500 ${darkMode ? 'bg-gray-700 border-gray-600' : 'bg-gray-50 border-gray-300'}`} /> </div> <div> <label htmlFor="dob" className={`block text-sm font-medium mb-1 ${darkMode ? 'text-gray-300' : 'text-gray-700'}`}>Date de naissance</label> <input type="date" name="dob" id="dob" value={formData.dob} onChange={handleChange} className={`w-full p-3 rounded-lg border focus:outline-none focus:ring-2 focus:ring-emerald-500 ${darkMode ? 'bg-gray-700 border-gray-600' : 'bg-gray-50 border-gray-300'}`} /> </div> <input type="url" name="photo" placeholder="URL de la photo" value={formData.photo} onChange={handleChange} className={`w-full p-3 rounded-lg border focus:outline-none focus:ring-2 focus:ring-emerald-500 ${darkMode ? 'bg-gray-700 border-gray-600' : 'bg-gray-50 border-gray-300'}`} /> <textarea name="notes" placeholder="Notes (caractère, habitudes...)" value={formData.notes} onChange={handleChange} rows="3" className={`w-full p-3 rounded-lg border focus:outline-none focus:ring-2 focus:ring-emerald-500 ${darkMode ? 'bg-gray-700 border-gray-600' : 'bg-gray-50 border-gray-300'}`}></textarea> <div className="flex justify-end space-x-4"> <button type="button" onClick={onClose} className={`py-2 px-6 rounded-lg font-semibold ${darkMode ? 'bg-gray-600 hover:bg-gray-500' : 'bg-gray-200 hover:bg-gray-300'}`}>Annuler</button> <button type="submit" className="bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-2 px-6 rounded-lg shadow-md">{animal ? 'Sauvegarder' : 'Ajouter'}</button> </div> </form> </div> </div> ); };
