import React, { useState, useEffect } from 'react';
import { Plus, X, ChevronDown, Sun, Moon, Heart, Shield, Rabbit, Bird, Bug, Calendar, ClipboardList, Edit, Trash2, ArrowLeft, ArrowRight } from 'lucide-react';

// Importations Firebase (v9+ modular SDK)
import { initializeApp } from "firebase/app";
import { getAuth, signInAnonymously, onAuthStateChanged } from "firebase/auth";
import { getFirestore, collection, onSnapshot, addDoc, doc, updateDoc, deleteDoc, arrayUnion, arrayRemove, Timestamp } from "firebase/firestore";

// --- CONFIGURATION FIREBASE ---
